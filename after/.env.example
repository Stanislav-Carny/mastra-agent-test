# Copy this file to `.env` and fill in the values, then run `npm run verify`.
# Never commit `.env`. The facilitator gives you the keys and base URLs.
#
# This project uses two providers:
#   - Anthropic answers the agent's chat turns and tool calls
#   - OpenAI creates the embeddings for expense-policy search

# --- Required: chat model (agent + workflow drafting step) ---
ANTHROPIC_API_KEY=
# Only needed when your key goes through a company AI gateway instead of
# api.anthropic.com. Leave blank to use Anthropic directly.
# Gateway URLs almost always have to end in /v1, e.g. https://<gateway-host>/api.anthropic.com/v1
ANTHROPIC_BASE_URL=

# --- Required: embeddings for the expense-policy vector index ---
OPENAI_API_KEY=
# Same rule as above: only set this when using a gateway.
OPENAI_BASE_URL=

# --- Optional: hosted storage instead of the local mastra.db file ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: send traces to the Mastra platform. Leave blank for a local-only setup ---
MASTRA_PLATFORM_ACCESS_TOKEN=
